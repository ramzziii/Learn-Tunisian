# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
dist-staging/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# generated placeholder audio (scripts/generate-placeholder-audio.sh) —
# upload to Supabase Storage, don't commit
/generated-audio

# native recordings (scripts/upload-audio.mjs uploads them to Storage) and
# the content pipeline's working files — never committed
/recordings/
*.mp3
*.m4a
/content-work/

# Supabase CLI local state (project link, etc.)
supabase/.temp/

# Claude Code plugin/skill installs that landed inside app/ rather than the
# user-level ~/.claude/ — tooling config, not part of this app.
/app/.claude/
/app/skills-lock.json
