# Copy this file to .env and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).
# EXPO_PUBLIC_ vars are inlined into the JS bundle at build time by Expo/Metro
# — do not put secrets here that aren't safe to ship in a client app. The
# anon key is safe: it's designed to be public and access is enforced by the
# Row Level Security policies in supabase/migrations/0001_init.sql.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# "Talk to a Tunisian" AI provider mode. Only chooses which client-side
# wrapper to use — never a secret. Defaults to "mock" (fully offline, no AI
# provider needed, tutor speech via on-device expo-speech, mic input
# disabled — typing only) if unset. Set to "live" once you've deployed the
# talk-to-a-tunisian / talk-tts / talk-stt Supabase Edge Functions and
# configured their AI_API_KEY secret (see supabase/functions/talk-to-a-tunisian/index.ts)
# to also get real AI replies, cloud text-to-speech, and mic input — the
# actual API key ALWAYS stays server-side as a Supabase secret, never here.
EXPO_PUBLIC_TALK_AI_MODE=mock
